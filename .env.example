# AQICN API Token (required)
# Get yours free at: https://aqicn.org/data-platform/token/
AQICN_API_TOKEN=your_aqicn_token_here

# Supabase Feature Store (required)
# Get your project URL and key from: https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_TABLE_NAME=aqi_features

# Hopsworks Model Registry (required)
# Get your API key from: https://app.hopsworks.ai
HOPSWORKS_API_KEY=
HOPSWORKS_HOST=eu-west.cloud.hopsworks.ai
HOPSWORKS_PROJECT_NAME=pearls_aqi_predictor

# OpenWeather API Key (optional fallback)
OPENWEATHER_API_KEY=
